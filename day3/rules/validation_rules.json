{
  "version": "m3-pravin-1",
  "_source": "day3/design/validation-rules-pravin.md (Lab 2 paper design). Rule types: day3/rules/RULE_TYPES.md.",
  "file_rules": [
    {"id": "F-01", "type": "header", "reason": "schema", "on_fail": "quarantine",
     "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "why": "A renamed or missing column (e.g. currency -> fare_currency) breaks every rule after it: reject the whole file."}
  ],
  "rules": [
    {"id": "R-01", "type": "required",
     "fields": ["pnr", "ticket_number", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "reason": "required", "on_fail": "quarantine",
     "why": "Nothing to settle or trace without them."},
    {"id": "R-02", "type": "regex", "field": "pnr", "pattern": "^[A-Z0-9]{6}$", "reason": "format", "on_fail": "quarantine",
     "why": "PNR is 6 upper-case letters/digits."},
    {"id": "R-03", "type": "regex", "field": "airline_code", "pattern": "^[A-Z0-9]{2}$", "reason": "format", "on_fail": "quarantine",
     "why": "IATA airline code is 2 characters (letters or digits, e.g. 6E)."},
    {"id": "R-04", "type": "required", "fields": ["airline_code"], "reason": "required", "on_fail": "quarantine",
     "why": "No airline code means no carrier to settle with."},
    {"id": "R-05", "type": "regex", "field": "fare_class", "pattern": "^[A-Z]$", "reason": "format", "on_fail": "quarantine",
     "why": "Booking class is a single upper-case letter."},
    {"id": "R-06", "type": "in_ref", "field": "fare_class", "ref": "fare_classes", "reason": "referential", "on_fail": "quarantine",
     "why": "Fare class must be in the airline's published list."},
    {"id": "R-07", "type": "regex", "field": "od_pair", "pattern": "^[A-Z]{3}-[A-Z]{3}$", "reason": "format", "on_fail": "quarantine",
     "why": "OD pair is two 3-letter airport codes joined by a hyphen."},
    {"id": "R-08", "type": "od_airports_in_ref", "field": "od_pair", "reason": "referential", "on_fail": "quarantine",
     "why": "Both airports must be known."},
    {"id": "R-09", "type": "od_distinct", "field": "od_pair", "reason": "business", "on_fail": "quarantine",
     "why": "Origin and destination cannot be the same airport."},
    {"id": "R-10", "type": "in_ref", "field": "airline_code", "ref": "airlines", "reason": "referential", "on_fail": "quarantine",
     "why": "We only settle airlines we have a contract for."},
    {"id": "R-11", "type": "decimal_places", "field": "fare_amount", "max_places": 2, "reason": "format", "on_fail": "quarantine",
     "why": "Money has at most 2 decimal places."},
    {"id": "R-12", "type": "min_exclusive", "field": "fare_amount", "value": 0, "reason": "business", "on_fail": "quarantine",
     "why": "A ticket issue must have a fare above zero."},
    {"id": "R-13", "type": "regex", "field": "currency", "pattern": "^[A-Z]{3}$", "reason": "format", "on_fail": "quarantine",
     "why": "Currency is a 3-letter ISO 4217 code."},
    {"id": "R-14", "type": "in_ref", "field": "currency", "ref": "currencies", "reason": "referential", "on_fail": "quarantine",
     "why": "Currency must be in the accepted list."},
    {"id": "R-15", "type": "regex", "field": "ticket_number", "pattern": "^[0-9]{3}-[0-9]{10}$", "reason": "format", "on_fail": "quarantine",
     "why": "Ticket number is a 3-digit prefix, a hyphen and 10 digits."},
    {"id": "R-16", "type": "ticket_prefix", "field": "ticket_number", "airline_field": "airline_code", "reason": "referential", "on_fail": "quarantine",
     "why": "The ticket prefix must belong to the issuing airline."},
    {"id": "R-17", "type": "date_format", "field": "issue_date", "format": "%Y-%m-%d", "reason": "format", "on_fail": "quarantine",
     "why": "Issue date must parse in the agreed feed format (YYYY-MM-DD)."},
    {"id": "R-18", "type": "date_not_after_file_date", "field": "issue_date", "reason": "business", "on_fail": "quarantine",
     "why": "A ticket cannot be issued after the file's business date."},
    {"id": "R-19", "type": "date_within_days", "field": "issue_date", "days": 30, "reason": "late", "on_fail": "flag",
     "why": "Valid but late (>30 days before file date): still settle it, flag for review."},
    {"id": "R-20", "type": "regex", "field": "agency_iata", "pattern": "^[0-9]{8}$", "reason": "format", "on_fail": "quarantine",
     "why": "Agency IATA number is 8 digits."},
    {"id": "R-21", "type": "unique", "field": "ticket_number", "reason": "duplicate", "on_fail": "skip",
     "why": "Same ticket twice in one file: keep the first, skip and count the repeat in the manifest."}
  ]
}
