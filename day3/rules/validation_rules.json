{
  "version": "m3-vikramsing-1",
  "file_rules": [
    {"id": "F-01", "type": "header", "reason": "schema", "on_fail": "quarantine",
     "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "why": "A renamed or missing column breaks every rule after it: reject the whole file."}
  ],
  "rules": [
    {"id": "R-01", "type": "required",
     "fields": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "reason": "required", "on_fail": "quarantine",
     "why": "Nothing to settle or trace without them."},
    {"id": "R-02", "type": "regex", "field": "pnr", "pattern": "^[A-Z0-9]{6}$", "reason": "format", "on_fail": "quarantine",
     "why": "A PNR is exactly 6 upper-case alphanumerics."},
    {"id": "R-03", "type": "regex", "field": "airline_code", "pattern": "^[A-Z0-9]{2}$", "reason": "format", "on_fail": "quarantine",
     "why": "An IATA airline code is always 2 characters (digits are allowed, e.g. 6E)."},
    {"id": "R-04", "type": "regex", "field": "fare_class", "pattern": "^[A-Z]$", "reason": "format", "on_fail": "quarantine",
     "why": "Booking classes are single capital letters."},
    {"id": "R-10", "type": "in_ref", "field": "airline_code", "ref": "airlines", "reason": "referential", "on_fail": "quarantine",
     "why": "We only settle airlines we have a contract for."},
    {"id": "R-11", "type": "in_ref", "field": "fare_class", "ref": "fare_classes", "reason": "referential", "on_fail": "quarantine",
     "why": "A class the airline does not publish cannot be priced or refunded."},
    {"id": "R-19", "type": "unique", "field": "ticket_number", "reason": "duplicate", "on_fail": "skip",
     "why": "Same ticket twice in one file: keep the first, skip and count the repeat."}
  ]
}
