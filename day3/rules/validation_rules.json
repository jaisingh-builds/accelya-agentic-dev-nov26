{
  "version": "m3-amol-1",
  "file_rules": [
    {
      "id": "F-01",
      "type": "header",
      "reason": "schema",
      "on_fail": "quarantine",
      "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
      "why": "A renamed or missing column breaks every rule after it: reject the whole file."
    }
  ],
  "rules": [
    {
      "id": "R-01",
      "type": "required",
      "fields": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
      "reason": "required",
      "on_fail": "quarantine",
      "why": "Nothing to settle or trace without mandatory fields."
    },
    {
      "id": "R-02",
      "type": "regex",
      "field": "pnr",
      "pattern": "^[A-Z0-9]{6}$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "PNR is a 6-char upper-case alphanumeric locator."
    },
    {
      "id": "R-03",
      "type": "regex",
      "field": "airline_code",
      "pattern": "^[A-Z0-9]{2}$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "IATA airline designator is exactly 2 upper-case characters."
    },
    {
      "id": "R-04",
      "type": "in_ref",
      "field": "airline_code",
      "ref": "airlines",
      "reason": "referential",
      "on_fail": "quarantine",
      "why": "Cannot settle against an unknown airline."
    },
    {
      "id": "R-05",
      "type": "regex",
      "field": "fare_class",
      "pattern": "^[A-Z]$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "Booking class is a single upper-case letter."
    },
    {
      "id": "R-06",
      "type": "in_ref",
      "field": "fare_class",
      "ref": "fare_classes",
      "reason": "referential",
      "on_fail": "quarantine",
      "why": "Fare class must be a published booking class."
    },
    {
      "id": "R-07",
      "type": "regex",
      "field": "od_pair",
      "pattern": "^[A-Z]{3}-[A-Z]{3}$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "OD pair must be two 3-letter IATA airport codes separated by hyphen."
    },
    {
      "id": "R-08",
      "type": "od_airports_in_ref",
      "field": "od_pair",
      "reason": "referential",
      "on_fail": "quarantine",
      "why": "Cannot route settlement for unknown airports."
    },
    {
      "id": "R-09",
      "type": "od_distinct",
      "field": "od_pair",
      "reason": "business",
      "on_fail": "quarantine",
      "why": "A flight from BOM to BOM is not a valid itinerary."
    },
    {
      "id": "R-10",
      "type": "decimal_places",
      "field": "fare_amount",
      "max_places": 2,
      "reason": "format",
      "on_fail": "quarantine",
      "why": "Fare amounts follow standard currency precision, max 2 decimal places."
    },
    {
      "id": "R-11",
      "type": "min_exclusive",
      "field": "fare_amount",
      "value": 0,
      "reason": "business",
      "on_fail": "quarantine",
      "why": "A zero or negative fare cannot be settled."
    },
    {
      "id": "R-12",
      "type": "in_ref",
      "field": "currency",
      "ref": "currencies",
      "reason": "referential",
      "on_fail": "quarantine",
      "why": "Cannot settle in an unrecognised currency."
    },
    {
      "id": "R-13",
      "type": "regex",
      "field": "ticket_number",
      "pattern": "^\\d{3}-\\d{10}$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "IATA ticket number is a 3-digit airline prefix followed by hyphen and 10-digit serial."
    },
    {
      "id": "R-14",
      "type": "ticket_prefix",
      "field": "ticket_number",
      "airline_field": "airline_code",
      "reason": "referential",
      "on_fail": "quarantine",
      "why": "Ticket prefix must match the airline's accounting code in airlines.json."
    },
    {
      "id": "R-15",
      "type": "date_format",
      "field": "issue_date",
      "format": "%Y-%m-%d",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "Issue date must be ISO YYYY-MM-DD for consistent downstream processing."
    },
    {
      "id": "R-16",
      "type": "date_not_after_file_date",
      "field": "issue_date",
      "reason": "business",
      "on_fail": "quarantine",
      "why": "A ticket cannot be issued after the file's business date."
    },
    {
      "id": "R-17",
      "type": "date_within_days",
      "field": "issue_date",
      "days": 30,
      "reason": "late",
      "on_fail": "flag",
      "why": "Valid but unusually old; finance should review but not reject."
    },
    {
      "id": "R-18",
      "type": "regex",
      "field": "agency_iata",
      "pattern": "^\\d{8}$",
      "reason": "format",
      "on_fail": "quarantine",
      "why": "IATA agency number is an 8-digit numeric code."
    },
    {
      "id": "R-19",
      "type": "unique",
      "field": "ticket_number",
      "reason": "duplicate",
      "on_fail": "skip",
      "why": "Same ticket twice in one file: keep the first, skip and count the repeat."
    }
  ]
}
