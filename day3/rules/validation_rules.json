{
  "version": "m3-chandra-1",
  "file_rules": [
    {"id": "F-01", "type": "header", "reason": "schema", "on_fail": "quarantine",
     "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "why": "A renamed or missing column breaks every rule after it: reject the whole file."}
  ],
  "rules": [
    {"id": "R-01", "type": "required",
     "fields": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "reason": "required", "on_fail": "quarantine",
     "why": "Every column is mandatory in the issue contract; an empty one leaves nothing to settle or trace."},
    {"id": "R-02", "type": "regex", "field": "pnr", "pattern": "^[A-Z0-9]{6}$",
     "reason": "format", "on_fail": "quarantine",
     "why": "PNR is 6 upper-case alphanumerics and the ordering key downstream."},
    {"id": "R-03", "type": "regex", "field": "airline_code", "pattern": "^[A-Z0-9]{2}$",
     "reason": "format", "on_fail": "quarantine",
     "why": "IATA airline code is exactly 2 characters; digits are allowed (e.g. 6E)."},
    {"id": "R-04", "type": "in_ref", "field": "airline_code", "ref": "airlines",
     "reason": "referential", "on_fail": "quarantine",
     "why": "We only settle airlines we have a contract for."},
    {"id": "R-05", "type": "regex", "field": "fare_class", "pattern": "^[A-Z]$",
     "reason": "format", "on_fail": "quarantine",
     "why": "Fare class is one upper-case IATA booking letter."},
    {"id": "R-06", "type": "in_ref", "field": "fare_class", "ref": "fare_classes",
     "reason": "referential", "on_fail": "quarantine",
     "why": "Unknown booking class means the refund percentage cannot be looked up."},
    {"id": "R-07", "type": "regex", "field": "od_pair", "pattern": "^[A-Z]{3}-[A-Z]{3}$",
     "reason": "format", "on_fail": "quarantine",
     "why": "OD pair must be AAA-BBB so the split yields exactly two airport codes."},
    {"id": "R-08", "type": "od_airports_in_ref", "field": "od_pair",
     "reason": "referential", "on_fail": "quarantine",
     "why": "An unknown airport cannot be priced or settled."},
    {"id": "R-09", "type": "od_distinct", "field": "od_pair",
     "reason": "business", "on_fail": "quarantine",
     "why": "Same origin and destination is a data or fraud problem, not a route we sell."},
    {"id": "R-10", "type": "decimal_places", "field": "fare_amount", "max_places": 2,
     "reason": "format", "on_fail": "quarantine",
     "why": "Money is Decimal; more than 2 decimal places is a producer defect."},
    {"id": "R-11", "type": "min_exclusive", "field": "fare_amount", "value": 0,
     "reason": "business", "on_fail": "quarantine",
     "why": "A negative or zero fare must never reach refund maths."},
    {"id": "R-12", "type": "in_ref", "field": "currency", "ref": "currencies",
     "reason": "referential", "on_fail": "quarantine",
     "why": "Settlement only accepts the agreed ISO-4217 list."},
    {"id": "R-13", "type": "regex", "field": "ticket_number", "pattern": "^\\d{3}-\\d{10}$",
     "reason": "format", "on_fail": "quarantine",
     "why": "Ticket number is a 3-digit stock code, hyphen, 10-digit serial."},
    {"id": "R-14", "type": "ticket_prefix", "field": "ticket_number", "airline_field": "airline_code",
     "reason": "referential", "on_fail": "quarantine",
     "why": "The ticket's 3-digit prefix must belong to the row's airline (098 for AI)."},
    {"id": "R-15", "type": "date_format", "field": "issue_date", "format": "%Y-%m-%d",
     "reason": "format", "on_fail": "quarantine",
     "why": "Every downstream date comparison needs ISO YYYY-MM-DD."},
    {"id": "R-16", "type": "date_not_after_file_date", "field": "issue_date",
     "reason": "business", "on_fail": "quarantine",
     "why": "A future issue date is a producer clock or fraud problem."},
    {"id": "R-17", "type": "date_within_days", "field": "issue_date", "days": 30,
     "reason": "late", "on_fail": "flag",
     "why": "Valid but outside the normal 30-day window: settle it, flag for ops."},
    {"id": "R-18", "type": "regex", "field": "agency_iata", "pattern": "^\\d{8}$",
     "reason": "format", "on_fail": "quarantine",
     "why": "IATA agency codes are exactly 8 digits."},
    {"id": "R-19", "type": "unique", "field": "ticket_number",
     "reason": "duplicate", "on_fail": "skip",
     "why": "Same ticket twice in one file: keep the first, skip and count the repeat."}
  ]
}
