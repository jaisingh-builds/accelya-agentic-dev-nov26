{
  "version": "m3-solution-1",
  "file_rules": [
    {"id": "F-01", "type": "header", "reason": "schema", "on_fail": "quarantine",
     "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "why": "A renamed or missing column breaks every downstream rule: reject the whole file, don't guess."}
  ],
  "rules": [
    {"id": "R-01", "type": "required", "fields": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency"],
     "reason": "required", "on_fail": "quarantine", "why": "No booking or ticket id = no way to settle or trace it."},
    {"id": "R-02", "type": "regex", "field": "pnr", "pattern": "^[A-Z0-9]{6}$", "reason": "format", "on_fail": "quarantine",
     "why": "PNR is 6 upper-case alphanumerics."},
    {"id": "R-03", "type": "regex", "field": "ticket_number", "pattern": "^[0-9]{3}-[0-9]{10}$", "reason": "format", "on_fail": "quarantine",
     "why": "3-digit airline prefix, hyphen, 10 digits."},
    {"id": "R-04", "type": "regex", "field": "airline_code", "pattern": "^[A-Z0-9]{2}$", "reason": "format", "on_fail": "quarantine",
     "why": "IATA airline designator: 2 characters, digits allowed (6E, 9W)."},
    {"id": "R-05", "type": "regex", "field": "fare_class", "pattern": "^[A-Z]$", "reason": "format", "on_fail": "quarantine",
     "why": "Booking class: one upper-case letter."},
    {"id": "R-06", "type": "regex", "field": "od_pair", "pattern": "^[A-Z]{3}-[A-Z]{3}$", "reason": "format", "on_fail": "quarantine",
     "why": "Origin-destination: two 3-letter airport codes."},
    {"id": "R-07", "type": "decimal_places", "field": "fare_amount", "max_places": 2, "reason": "format", "on_fail": "quarantine",
     "why": "Money has 2 decimal places; 3 means a unit or rounding bug upstream."},
    {"id": "R-08", "type": "date_format", "field": "issue_date", "format": "%Y-%m-%d", "reason": "format", "on_fail": "quarantine",
     "why": "ISO dates only; 25/11/2026 is ambiguous across markets."},
    {"id": "R-09", "type": "regex", "field": "agency_iata", "pattern": "^[0-9]{8}$", "reason": "format", "on_fail": "quarantine",
     "why": "IATA agency number: 8 digits."},
    {"id": "R-10", "type": "in_ref", "field": "airline_code", "ref": "airlines", "reason": "referential", "on_fail": "quarantine",
     "why": "We only settle airlines we have a contract for."},
    {"id": "R-11", "type": "ticket_prefix", "field": "ticket_number", "airline_field": "airline_code", "reason": "referential", "on_fail": "quarantine",
     "why": "The ticket's 3-digit prefix must belong to the airline that issued it."},
    {"id": "R-12", "type": "in_ref", "field": "fare_class", "ref": "fare_classes", "reason": "referential", "on_fail": "quarantine",
     "why": "Class must exist in the airline's published list."},
    {"id": "R-13", "type": "od_airports_in_ref", "field": "od_pair", "reason": "referential", "on_fail": "quarantine",
     "why": "Both airports must be known codes."},
    {"id": "R-14", "type": "in_ref", "field": "currency", "ref": "currencies", "reason": "referential", "on_fail": "quarantine",
     "why": "ISO 4217 currency we accept."},
    {"id": "R-15", "type": "od_distinct", "field": "od_pair", "reason": "business", "on_fail": "quarantine",
     "why": "Origin and destination can't be the same airport."},
    {"id": "R-16", "type": "min_exclusive", "field": "fare_amount", "value": 0, "reason": "business", "on_fail": "quarantine",
     "why": "An issued ticket has a positive fare; refunds come as cancellation events, not negative issues."},
    {"id": "R-17", "type": "date_not_after_file_date", "field": "issue_date", "reason": "business", "on_fail": "quarantine",
     "why": "A ticket can't be issued after the file's business date. Relative to the FILE date, so reruns give the same answer."},
    {"id": "R-18", "type": "date_within_days", "field": "issue_date", "days": 30, "reason": "late", "on_fail": "flag",
     "why": "Late but valid: settle it, flag it for the settlement team. Don't quarantine good money."},
    {"id": "R-19", "type": "unique", "field": "ticket_number", "reason": "duplicate", "on_fail": "skip",
     "why": "Same ticket twice in a file: keep the first, skip and count the repeat."}
  ]
}
