{
  "version": "m3-vikramsing-2",
  "file_rules": [
    {"id": "F-01", "type": "header", "reason": "schema", "on_fail": "quarantine",
     "columns": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "why": "A renamed or missing column breaks every rule after it: reject the whole file."}
  ],
  "rules": [
    {"id": "R-01", "type": "required",
     "fields": ["pnr", "ticket_number", "airline_code", "fare_class", "od_pair", "issue_date", "fare_amount", "currency", "agency_iata"],
     "reason": "required", "on_fail": "quarantine",
     "why": "Nothing to settle or trace without them."},
    {"id": "R-02", "type": "regex", "field": "pnr", "pattern": "^[A-Z0-9]{6}$", "reason": "format", "on_fail": "quarantine",
     "why": "A PNR is exactly 6 upper-case alphanumerics."},
    {"id": "R-03", "type": "regex", "field": "airline_code", "pattern": "^[A-Z0-9]{2}$", "reason": "format", "on_fail": "quarantine",
     "why": "An IATA airline code is always 2 characters (digits are allowed, e.g. 6E)."},
    {"id": "R-04", "type": "regex", "field": "fare_class", "pattern": "^[A-Z]$", "reason": "format", "on_fail": "quarantine",
     "why": "Booking classes are single capital letters."},
    {"id": "R-05", "type": "regex", "field": "od_pair", "pattern": "^[A-Z]{3}-[A-Z]{3}$", "reason": "format", "on_fail": "quarantine",
     "why": "The pair must be shaped AAA-BBB before its airports can be checked."},
    {"id": "R-06", "type": "decimal_places", "field": "fare_amount", "max_places": 2, "reason": "format", "on_fail": "quarantine",
     "why": "Money has at most 2 decimal places; more means a bad value."},
    {"id": "R-07", "type": "regex", "field": "ticket_number", "pattern": "^\\d{3}-\\d{10}$", "reason": "format", "on_fail": "quarantine",
     "why": "A ticket number is a 3-digit airline prefix, a hyphen and 10 digits."},
    {"id": "R-08", "type": "date_format", "field": "issue_date", "format": "%Y-%m-%d", "reason": "format", "on_fail": "quarantine",
     "why": "Every later date rule needs an ISO date."},
    {"id": "R-09", "type": "regex", "field": "agency_iata", "pattern": "^\\d{8}$", "reason": "format", "on_fail": "quarantine",
     "why": "An agency IATA number has exactly 8 digits."},
    {"id": "R-10", "type": "in_ref", "field": "airline_code", "ref": "airlines", "reason": "referential", "on_fail": "quarantine",
     "why": "We only settle airlines we have a contract for."},
    {"id": "R-11", "type": "in_ref", "field": "fare_class", "ref": "fare_classes", "reason": "referential", "on_fail": "quarantine",
     "why": "A class the airline does not publish cannot be priced or refunded."},
    {"id": "R-12", "type": "od_airports_in_ref", "field": "od_pair", "reason": "referential", "on_fail": "quarantine",
     "why": "An unknown airport code cannot be settled or reported."},
    {"id": "R-13", "type": "od_distinct", "field": "od_pair", "reason": "business", "on_fail": "quarantine",
     "why": "A journey from an airport to itself is not a real ticket."},
    {"id": "R-14", "type": "min_exclusive", "field": "fare_amount", "value": 0, "reason": "business", "on_fail": "quarantine",
     "why": "A zero or negative fare is not a valid issue."},
    {"id": "R-15", "type": "in_ref", "field": "currency", "ref": "currencies", "reason": "referential", "on_fail": "quarantine",
     "why": "Only accepted ISO 4217 currencies can be settled."},
    {"id": "R-16", "type": "ticket_prefix", "field": "ticket_number", "airline_field": "airline_code", "reason": "referential", "on_fail": "quarantine",
     "why": "A ticket carrying another airline's prefix is mislabelled."},
    {"id": "R-17", "type": "date_not_after_file_date", "field": "issue_date", "reason": "business", "on_fail": "quarantine",
     "why": "A ticket cannot be issued after the file's business date."},
    {"id": "R-18", "type": "date_within_days", "field": "issue_date", "days": 30, "reason": "late", "on_fail": "flag",
     "why": "Valid and settleable, but more than 30 days old: a reviewer should see why it is late."},
    {"id": "R-19", "type": "unique", "field": "ticket_number", "reason": "duplicate", "on_fail": "skip",
     "why": "Same ticket twice in one file: keep the first, skip and count the repeat."}
  ]
}
